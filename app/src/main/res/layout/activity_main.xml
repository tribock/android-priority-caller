<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSelectedContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No priority contact selected"
        android:textSize="16sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnPickContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Choose priority contacts" />

    <Button
        android:id="@+id/btnCallScreeningRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Grant Call Screening role" />

    <Button
        android:id="@+id/btnDndAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="3. Grant Do Not Disturb access" />

    <Button
        android:id="@+id/btnMiuiAutostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4. Open MIUI Autostart settings" />

    <Button
        android:id="@+id/btnMiuiBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="5. Open MIUI Battery saver settings" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="13sp"
        android:textColor="#666666" />

</LinearLayout>
